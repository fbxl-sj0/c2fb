/'
    Project: C2FB SQLite adapters

    File: c2fb_sqlite_header.bi

    Purpose:

        Emit FreeBASIC declarations for the SQLite public C header.

    Responsibilities:

        - Select the SQLite header ABI profile and prototype-only collection.
        - Write the SQLite header comment and required generated includes.
        - Lower collected function declarations through the shared prototype model.
        - Report converted and skipped declaration totals.

    This file intentionally does NOT contain:

        - C declaration scanning, tokenization, or prototype parsing.
        - Generic C-header mapping or function-body translation.
'/

Private Sub ConvertHeader( _
    ByRef translation As C2fbTranslationContext, _
    ByRef catalog As C2fbProjectCatalog, _
    ByRef request As C2fbFileConversionRequestModel _
)
    Dim inputPath As String = request.inputPath
    Dim outputPath As String = request.outputPath
    If ConfigureC2fbTranslationTarget( _
        translation, C2FB_TARGET_SQLITE, _
        C2FB_SOURCE_MAP_DISABLED) = 0 Then _
        ReportError("invalid SQLite header target context")
    Dim declarationScan As C2fbDeclarationScanRequestModel
    ConfigureC2fbPrototypeScanRequest( _
        declarationScan, inputPath, inputPath)
    If CollectC2fbDeclarationsInSourceUnit( _
        translation.sourceUnit, declarationScan) = 0 Then _
        ReportError("cannot read C declaration input: " & inputPath)

    Dim fileOutput As C2fbGeneratedFileOutputModel
    If OpenC2fbGeneratedFileOutput(fileOutput, outputPath) = 0 Then _
        ReportError("cannot write FreeBASIC header: " & outputPath)
    Dim fileComment As C2fbGeneratedFileCommentModel
    ResetC2fbGeneratedFileComment(fileComment)
    If AddC2fbGeneratedFileCommentLine( _
        fileComment, "    Generated C ABI declarations") = 0 OrElse _
       AddC2fbGeneratedFileCommentLine( _
        fileComment, "    Source: " & inputPath) = 0 OrElse _
        AddC2fbGeneratedFileCommentLine( _
        fileComment, "    Generated by fb_tools/c2fb/c2fb.bas. Review before relying on a declaration.") = 0 Then _
        ReportError("header file comment exceeds its limit")
    Dim filePreamble As C2fbGeneratedFilePreambleModel
    If AddC2fbGeneratedFileIncludeOnce( _
        filePreamble, "sqlite3_types.bi") = 0 OrElse _
       AddC2fbGeneratedFileIncludeOnce( _
        filePreamble, "sqlite3_constants.bi") = 0 Then _
        ReportError("header preamble exceeds its configured limit")
    If FileNameOnly(inputPath) = "sqliteInt.h" Then
        If AddC2fbGeneratedFileIncludeOnce( _
            filePreamble, "sqlite3_parser_token.bi") = 0 Then _
            ReportError("header preamble exceeds its configured limit")
    End If
    If AddC2fbGeneratedFilePreambleBlank(filePreamble) = 0 Then _
        ReportError("header preamble exceeds its configured limit")
    WriteC2fbGeneratedFilePreamble(fileOutput, fileComment, filePreamble)
    WriteC2fbAbiTypeAliases(translation, fileOutput)

    Dim names() As String
    ReDim names(0 To 63)
    Dim nameCount As Long = 0
    Dim outputNames() As String
    ReDim outputNames(0 To 63)
    Dim outputNameCount As Long = 0
    Dim conversionSummary As C2fbConversionSummaryModel
    For declarationIndex As Long = 0 To translation.sourceUnit.declarationCount - 1
        If translation.sourceUnit.declarations(declarationIndex).entryKind <> _
           C2FB_DECLARATION_FUNCTION Then Continue For
        translation.sourceUnit.diagnosticState.currentSourceLocation.path = _
            translation.sourceUnit.declarations(declarationIndex).sourceSpan.startLocation.path
        translation.sourceUnit.diagnosticState.currentSourceLocation.line = _
            translation.sourceUnit.declarations(declarationIndex).sourceSpan.startLocation.line
        EmitPrototypeModel( _
            translation, catalog, translation.sourceUnit.declarations(declarationIndex), fileOutput, _
            names(), nameCount, outputNames(), outputNameCount, _
            conversionSummary)
    Next

    WriteC2fbGeneratedFileLine(fileOutput, "")
    WriteC2fbGeneratedFileEndMarker(fileOutput)
    CloseC2fbGeneratedFileOutput(fileOutput)
    If C2fbGeneratedFileOutputHasFailed(fileOutput) <> 0 Then _
        ReportError(C2fbGeneratedFileOutputFailureMessage( _
            fileOutput, "cannot finish FreeBASIC header: " & outputPath))
    Print "converted " & Trim(Str(conversionSummary.convertedCount)) & _
        " declarations; skipped " & _
        Trim(Str(conversionSummary.skippedCount)) & " unsupported declarations; output " & outputPath
End Sub
/' end of c2fb_sqlite_header.bi '/
