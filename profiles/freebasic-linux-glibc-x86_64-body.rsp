# Project: C2FB FreeBASIC interoperability profile
# File: freebasic-linux-glibc-x86_64-body.rsp
# Purpose: Match generic body type resolution to the Linux x86-64 glibc CRT.
# Use with bindings generated by freebasic-linux-glibc-x86_64.rsp.

--type-map=__gnuc_va_list=Cva_List
--type-map=__builtin_va_list=Cva_List
--type-map=__mbstate_t=mbstate_t
--type-map=__atomic_wide_counter=ULongInt
--type-map=__time_t=CLong
--type-map=__syscall_slong_t=CLong
--type-map=lldiv_t=lldiv_t
--type-map=ssize_t=ssize_t
--type-map=pthread_t=CULong
--type-map=FILE=FILE
--type-map=pthread_mutex_t=pthread_mutex_t
--type-map=pthread_mutexattr_t=pthread_mutexattr_t
--type-map=pthread_cond_t=pthread_cond_t
--type-map=pthread_condattr_t=pthread_condattr_t
--type-map=pthread_once_t=pthread_once_t
--type-map=fb_off_t=off_t
--type-map=wchar_t=Long
--type-map=intptr_t=CLong
--type-map=uintptr_t=CULong

# Match glibc x86-64 pthread storage and time types used by source-unit bodies.
# end of freebasic-linux-glibc-x86_64-body.rsp
